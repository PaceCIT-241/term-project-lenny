ALTER TABLE ClimateRecord
ADD FOREIGN KEY (category_id)
REFERENCES ClimateCategory(category_id);

UPDATE ClimateRecord SET category_id = 1 WHERE avg_max_temperature < 8;

UPDATE ClimateRecord SET category_id = 2 WHERE avg_max_temperature BETWEEN 8 AND 16;

UPDATE ClimateRecord SET category_id = 3 WHERE avg_max_temperature > 16;



